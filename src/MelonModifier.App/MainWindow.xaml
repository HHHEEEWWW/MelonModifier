<Window x:Class="MelonModifier.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MelonModifier.App.ViewModels"
        Title="MelonModifier"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="{DynamicResource Font.Main}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <!-- 全局字号缩放（外观页调节） -->
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding State.Settings.FontScale}"
                            ScaleY="{Binding State.Settings.FontScale}" />
        </Grid.LayoutTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ==================== 主区域 ==================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========== 侧边导航 ========== -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.BgMid}" BorderBrush="{DynamicResource Brush.BorderLine}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Margin="20,22,20,26">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Neon}"
                                       Effect="{DynamicResource Fx.GlowNeon}"
                                       Text="MELON" />
                            <TextBlock FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextDim}"
                                       Text=" // " />
                            <TextBlock FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.HoloBlue}"
                                       Text="MODIFIER" />
                        </StackPanel>
                        <TextBlock Margin="2,5,0,0" FontSize="10.5" FontFamily="{DynamicResource Font.Mono}"
                                   Foreground="{DynamicResource Brush.TextDim}"
                                   Text="UNITY MOD LOADER CONSOLE" />
                    </StackPanel>

                    <!-- 导航项 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource NavItem}"
                                             Tag="{Binding Icon}"
                                             Content="{Binding Title}"
                                             GroupName="nav"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 底部版本 -->
                    <StackPanel Grid.Row="2" Margin="20,0,20,18">
                        <TextBlock FontSize="10.5" FontFamily="{DynamicResource Font.Mono}"
                                   Foreground="{DynamicResource Brush.TextDim}"
                                   Text="MelonModifier v0.1.0" />
                        <TextBlock FontSize="10.5" FontFamily="{DynamicResource Font.Mono}"
                                   Foreground="{DynamicResource Brush.TextDim}"
                                   Text="MelonLoader 管理器 · Windows" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== 内容区 ========== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题栏（发光细线 + 窗口按钮） -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Rectangle Height="1" VerticalAlignment="Top"
                               Fill="{DynamicResource Brush.TopLine}" />
                    <TextBlock Margin="18,0,0,0" VerticalAlignment="Center"
                               FontSize="11" FontFamily="{DynamicResource Font.Mono}"
                               Foreground="{DynamicResource Brush.TextDim}"
                               Text="{Binding SelectedPage.Title, StringFormat=// {0}}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WinButton}" Content="&#xE921;"
                                Click="Minimize_Click" ToolTip="最小化" />
                        <Button x:Name="MaxBtn" Style="{StaticResource WinButton}" Content="&#xE922;"
                                Click="Maximize_Click" ToolTip="最大化" />
                        <Button Style="{StaticResource WinButtonClose}" Content="&#xE8BB;"
                                Click="Close_Click" ToolTip="关闭" />
                    </StackPanel>
                </Grid>

                <!-- 页面宿主（带切换动画） -->
                <Grid Grid.Row="1">
                    <ContentControl x:Name="PageHost" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.BgDeep}" BorderBrush="{DynamicResource Brush.BorderLine}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Success}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           FontSize="11" FontFamily="{DynamicResource Font.Mono}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           Text="{Binding State.StatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
