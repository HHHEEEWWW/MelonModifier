<UserControl x:Class="MelonModifier.App.Views.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MelonModifier.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:IntToVisibilityConverter x:Key="CountToVis" />
        <conv:StatusKindToBrushConverter x:Key="StatusKindToBrush" />
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部操作栏 ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="游戏库" />
                <TextBlock Style="{StaticResource SubTitle}" Margin="0,3,0,0"
                           Text="扫描 Steam 库中的 Unity 游戏，或手动添加游戏目录" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding RefreshAllCommand}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="刷新状态" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding AddGameCommand}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="添加游戏" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Command="{Binding ScanCommand}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="扫描 Steam" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ 游戏卡片区 ============ -->
        <Grid Grid.Row="1">
            <!-- 空状态 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Games.Count, Converter={StaticResource CountToVis}}">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                           Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" />
                <TextBlock Text="尚未发现游戏" FontSize="15" Foreground="{DynamicResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="点击「扫描 Steam」自动发现 Unity 游戏，或「添加游戏」手动选择目录"
                           FontSize="12" Foreground="{DynamicResource Brush.TextDim}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer Style="{StaticResource SciScrollViewer}" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ===== 游戏卡片 ===== -->
                            <Border Style="{StaticResource PanelCard}" Width="348" Margin="0,0,12,12" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 名称 + 状态徽章 -->
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}" />
                                        </Border>
                                    </Grid>

                                    <!-- 引擎徽章 + BepInEx 徽章 -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.BgActive}">
                                            <TextBlock Text="{Binding EngineLabel}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       Foreground="{DynamicResource Brush.HoloBlue}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="#2200E676" Margin="6,0,0,0"
                                                Visibility="{Binding HasBepInEx, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding BepInExStatusText}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       Foreground="{DynamicResource Brush.Neon}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- 路径 -->
                                    <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="11.5"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               Foreground="{DynamicResource Brush.TextDim}"
                                               Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}" />

                                    <!-- 版本 -->
                                    <TextBlock Grid.Row="3" Margin="0,6,0,0" FontSize="11.5"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding VersionSummary}" />

                                    <!-- 操作按钮 -->
                                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource BtnPrimary}" Content="{Binding InstallButtonText}"
                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanInstallOrUpgrade}" />
                                        <Button Style="{StaticResource BtnDanger}" Content="卸载" Margin="8,0,0,0"
                                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource BtnGhost}" Content="管理" Margin="8,0,0,0"
                                                Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <!-- BepInEx 操作按钮 -->
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource BtnGhost}" Content="{Binding BepInExButtonText}"
                                                Command="{Binding DataContext.InstallBepInExCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanInstallBepInEx}" />
                                        <Button Style="{StaticResource BtnDanger}" Content="卸 BepInEx" Margin="8,0,0,0"
                                                Command="{Binding DataContext.UninstallBepInExCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanUninstallBepInEx, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ============ 详情面板 ============ -->
        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Margin="0,14,0,0" Padding="16"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="已选游戏：" FontSize="12.5" Foreground="{DynamicResource Brush.TextDim}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedGame.Name}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Neon}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedGame.VersionSummary}" FontSize="11.5"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <Grid Margin="0,8,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="11.5"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Height="4" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressValue}"
                                     Foreground="{DynamicResource Brush.Neon}"
                                     Background="{DynamicResource Brush.BgActive}" BorderThickness="0" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding OpenGameFolderCommand}" CommandParameter="{Binding SelectedGame}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="打开目录" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
