<UserControl x:Class="MelonModifier.App.Views.CompatibilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:MelonModifier.Core.Models;assembly=MelonModifier.Core"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- 引擎徽章颜色：Il2Cpp=全息蓝，Mono=霓虹绿，其他=暗灰 -->
        <Style x:Key="EngineBadge" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Engine}" Value="Il2Cpp">
                    <Setter Property="Background" Value="#220080FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Engine}" Value="Mono">
                    <Setter Property="Background" Value="#2200E676" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EngineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Engine}" Value="Il2Cpp">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.HoloBlue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Engine}" Value="Mono">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Neon}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SectionTitle}" Text="兼容性参考" />
            <TextBlock Style="{StaticResource SubTitle}" Margin="0,3,0,0">
                <Run Text="热门 Unity 游戏与 Mod 框架适配清单（共 " />
                <Run Text="{Binding TotalCount, Mode=OneWay}" />
                <Run Text=" 款）。引擎决定安装方式：Mono 游戏两种框架均友好，Il2Cpp 需首次启动生成互操作程序集。" />
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0"
                      Style="{StaticResource SciScrollViewer}"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Category}" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Neon}"
                                           Effect="{DynamicResource Fx.GlowNeon}" />
                                <TextBlock Text="{Binding Items.Count, StringFormat='  ({0})'}" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextDim}"
                                           VerticalAlignment="Bottom" Margin="6,0,0,2" />
                            </StackPanel>

                            <Border Style="{StaticResource PanelCard}" Padding="10,6" Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="200" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           VerticalAlignment="Center" Margin="0,0,14,0" />

                                                <Border Grid.Column="1" Style="{StaticResource EngineBadge}"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Style="{StaticResource EngineText}"
                                                               Text="{Binding EngineLabel}" />
                                                </Border>

                                                <TextBlock Grid.Column="2" Text="{Binding Framework}" FontSize="12"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           VerticalAlignment="Center" Margin="14,0,0,0" />

                                                <TextBlock Grid.Column="3" Text="{Binding Notes}" FontSize="11.5"
                                                           Foreground="{DynamicResource Brush.TextDim}"
                                                           VerticalAlignment="Center" Margin="14,0,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
