<UserControl x:Class="MelonModifier.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MelonModifier.App"
             xmlns:conv="clr-namespace:MelonModifier.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="日志" />
                <TextBlock Style="{StaticResource SubTitle}" Margin="0,3,0,0"
                           Text="查看游戏 MelonLoader/Logs 下的运行日志（崩溃排查用）" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="目标游戏" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="240" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Games}"
                          SelectedItem="{Binding SelectedGame, Source={x:Static local:App.State}, Mode=TwoWay}"
                          DisplayMemberPath="Name">
                    
                </ComboBox>
                <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                        Command="{Binding RefreshLogsCommand}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 日志区 -->
        <Grid Grid.Row="1" Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 文件列表 -->
            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="LOG FILES" FontSize="11" FontWeight="Bold"
                               FontFamily="{StaticResource Font.Mono}"
                               Foreground="{StaticResource Brush.TextDim}" Margin="4,0,0,8" />
                    <ListBox Grid.Row="1" Style="{StaticResource SciListBox}"
                             ItemsSource="{Binding LogFiles}"
                             SelectedItem="{Binding SelectedLog, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 内容 -->
            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Padding="0">
                <TextBox IsReadOnly="True" BorderThickness="0" Background="#0A0F18"
                         Foreground="#B8C7DD" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                         Text="{Binding LogContent, Mode=OneWay}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Padding="12" SelectionBrush="#6600E5FF" CaretBrush="{StaticResource Brush.Neon}" />
            </Border>
        </Grid>

        <!-- 未选择提示 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                       Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding GameHint}" FontSize="14"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
