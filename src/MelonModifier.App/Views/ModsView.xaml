<UserControl x:Class="MelonModifier.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MelonModifier.App"
             xmlns:conv="clr-namespace:MelonModifier.App.Converters"
             AllowDrop="True"
             DragOver="Grid_DragOver"
             Drop="Grid_Drop">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部 ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Mods 管理" />
                <TextBlock Style="{StaticResource SubTitle}" Margin="0,3,0,0"
                           Text="管理游戏目录下 Mods/ 与 Plugins/ 中的 DLL，支持拖拽安装" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="目标游戏" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="260" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Games}"
                          SelectedItem="{Binding SelectedGame, Source={x:Static local:App.State}, Mode=TwoWay}"
                          DisplayMemberPath="Name">
                    
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- ============ 内容 ============ -->
        <Grid Grid.Row="1" Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Mods 列 -->
            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="14" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MODS" FontSize="12.5" FontWeight="Bold"
                                       FontFamily="{StaticResource Font.Mono}"
                                       Foreground="{StaticResource Brush.Neon}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Mods.Count}" FontSize="11"
                                           FontFamily="{StaticResource Font.Mono}"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                            </Border>
                        </StackPanel>
                                                <Button Style="{StaticResource BtnIcon}" HorizontalAlignment="Right" Padding="8,4"
                                Command="{Binding OpenModsFolderCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="打开文件夹" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource SciScrollViewer}"
                                  VerticalScrollBarVisibility="Auto"
                                  AllowDrop="True"
                                  DragOver="ModsPanel_DragOver" Drop="ModsPanel_Drop">
                        <ItemsControl ItemsSource="{Binding Mods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                       Foreground="{StaticResource Brush.TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}" />
                                            <TextBlock FontSize="10.5" FontFamily="{StaticResource Font.Mono}"
                                                       Foreground="{StaticResource Brush.TextDim}"
                                                       Text="{Binding SizeLabel}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" FontSize="10.5"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   Foreground="{StaticResource Brush.TextDim}"
                                                   Text="{Binding LastModified, StringFormat={}{0:MM-dd HH:mm}}"
                                                   VerticalAlignment="Center" Margin="8,0" />

                                        <CheckBox Grid.Column="2" Style="{StaticResource SciToggle}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=启用 {0}}"
                                                  Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  VerticalAlignment="Center" Margin="10,0" />
                                        <Button Grid.Column="3" Style="{StaticResource BtnIcon}" Margin="6,0,0,0"
                                        VerticalAlignment="Center" ToolTip="删除"
                                        AutomationProperties.Name="{Binding Name, StringFormat=删除 {0}}"
                                        Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="删除" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Plugins 列 -->
            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Padding="14" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PLUGINS" FontSize="12.5" FontWeight="Bold"
                                       FontFamily="{StaticResource Font.Mono}"
                                       Foreground="{StaticResource Brush.HoloBlue}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Plugins.Count}" FontSize="11"
                                           FontFamily="{StaticResource Font.Mono}"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                            </Border>
                        </StackPanel>
                                                <Button Style="{StaticResource BtnIcon}" HorizontalAlignment="Right" Padding="8,4"
                                Command="{Binding OpenPluginsFolderCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="打开文件夹" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource SciScrollViewer}"
                                  VerticalScrollBarVisibility="Auto"
                                  AllowDrop="True"
                                  DragOver="PluginsPanel_DragOver" Drop="PluginsPanel_Drop">
                        <ItemsControl ItemsSource="{Binding Plugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                       Foreground="{StaticResource Brush.TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}" />
                                            <TextBlock FontSize="10.5" FontFamily="{StaticResource Font.Mono}"
                                                       Foreground="{StaticResource Brush.TextDim}"
                                                       Text="{Binding SizeLabel}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" FontSize="10.5"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   Foreground="{StaticResource Brush.TextDim}"
                                                   Text="{Binding LastModified, StringFormat={}{0:MM-dd HH:mm}}"
                                                   VerticalAlignment="Center" Margin="8,0" />

                                        <CheckBox Grid.Column="2" Style="{StaticResource SciToggle}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=启用 {0}}"
                                                  Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  VerticalAlignment="Center" Margin="10,0" />
                                        <Button Grid.Column="3" Style="{StaticResource BtnIcon}" Margin="6,0,0,0"
                                        VerticalAlignment="Center" ToolTip="删除"
                                        AutomationProperties.Name="{Binding Name, StringFormat=删除 {0}}"
                                        Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="删除" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 未选择游戏提示 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                       Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding GameHint}" FontSize="14"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock Text="在游戏库卡片上点击「管理」选中目标游戏，或将 DLL 直接拖入下方区域"
                       FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
