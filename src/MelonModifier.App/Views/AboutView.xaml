<UserControl x:Class="MelonModifier.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SectionTitle}" Text="关于" />
            <TextBlock Style="{StaticResource SubTitle}" Margin="0,3,0,0"
                       Text="MelonModifier —— Unity 游戏 MelonLoader 本地管理器" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="28" Margin="0,16,0,0"
                VerticalAlignment="Top" MaxWidth="640">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="30" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Neon}"
                               Effect="{DynamicResource Fx.GlowNeon}"
                               Text="MELON" />
                    <TextBlock FontSize="30" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextDim}" Text=" // " />
                    <TextBlock FontSize="30" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.HoloBlue}"
                               Text="MODIFIER" />
                </StackPanel>

                <TextBlock Margin="0,8,0,0" FontSize="12.5"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap"
                           Text="为 Unity 游戏安装、升级、卸载 MelonLoader（支持 Il2Cpp 与 Mono），管理本地 Mods/Plugins，查看运行日志与 Loader.cfg 配置。" />

                <Rectangle Height="1" Margin="0,18,0,18" Fill="{DynamicResource Brush.BorderLine}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" FontSize="12"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="v0.1.0（开发版）" FontSize="12"
                               FontFamily="{DynamicResource Font.Mono}"
                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="框架" FontSize="12"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="WPF · .NET 9 · C#" FontSize="12"
                               FontFamily="{DynamicResource Font.Mono}"
                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="目标" FontSize="12"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="MelonLoader v0.7.x（Windows x64）" FontSize="12"
                               FontFamily="{DynamicResource Font.Mono}"
                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="上游" FontSize="12"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12"
                               Foreground="{DynamicResource Brush.HoloBlue}" Margin="0,4">
                        <Hyperlink NavigateUri="https://github.com/LavaGang/MelonLoader"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource Brush.HoloBlue}">
                            LavaGang/MelonLoader
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="数据目录" FontSize="12"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,4" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="%AppData%\MelonModifier" FontSize="12"
                               FontFamily="{DynamicResource Font.Mono}"
                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="说明" FontSize="12"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,4" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="仅管理本地文件，不从 Thunderstore 下载 mod" FontSize="12"
                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
