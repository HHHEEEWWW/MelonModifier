<UserControl x:Class="MelonModifier.App.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MelonModifier.App"
             xmlns:conv="clr-namespace:MelonModifier.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="配置" />
                <TextBlock Style="{StaticResource SubTitle}" Margin="0,3,0,0"
                           Text="编辑 UserData/Loader.cfg（全文模式，保留注释与未知键）" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="目标游戏" FontSize="12.5" Foreground="{DynamicResource Brush.TextDim}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="240" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Games}"
                          SelectedItem="{Binding SelectedGame, Source={x:Static local:App.State}, Mode=TwoWay}"
                          DisplayMemberPath="Name">
                    
                </ComboBox>
                <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                        Command="{Binding ReloadConfigCommand}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="重新载入" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                        Command="{Binding SaveConfigCommand}"
                        IsEnabled="{Binding IsDirty}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="保存" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 内容 -->
        <Grid Grid.Row="1" Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 键值摘要 -->
            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <TextBlock Text="KEY / VALUE" FontSize="11" FontWeight="Bold"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   Foreground="{DynamicResource Brush.TextDim}" />
                        <Button Style="{StaticResource BtnIcon}"
                                HorizontalAlignment="Right" Padding="8,3" FontSize="11"
                                Command="{Binding OpenConfigFileCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="打开文件" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Style="{StaticResource SciScrollViewer}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayKey}"
                                                   FontSize="11.5" FontFamily="{DynamicResource Font.Mono}"
                                                   Foreground="{DynamicResource Brush.HoloBlue}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayKey}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   FontSize="11.5" FontFamily="{DynamicResource Font.Mono}"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   MaxWidth="120" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 全文编辑器 -->
            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Padding="0">
                <TextBox Text="{Binding RawContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource Brush.BgDeep}" BorderThickness="0"
                         Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Padding="12" SelectionBrush="#6600E5FF" CaretBrush="{DynamicResource Brush.Neon}"
                         AcceptsReturn="True" SpellCheck.IsEnabled="False" />
            </Border>
        </Grid>

        <!-- 未选择提示 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                       Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding GameHint}" FontSize="14"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
