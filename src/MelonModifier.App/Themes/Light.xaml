<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 日间（Light）色板 ==================== -->
    <Color x:Key="Color.BgDeep">#F3F6FB</Color>
    <Color x:Key="Color.BgMid">#E9EFF7</Color>
    <Color x:Key="Color.BgPanel">#FFFFFF</Color>
    <Color x:Key="Color.BgHover">#DEE8F4</Color>
    <Color x:Key="Color.BgActive">#CFE1F2</Color>

    <Color x:Key="Color.Neon">#0091B8</Color>
    <Color x:Key="Color.HoloBlue">#2E6FC2</Color>
    <Color x:Key="Color.Violet">#6A4FD8</Color>
    <Color x:Key="Color.Magenta">#D62477</Color>
    <Color x:Key="Color.Danger">#E0435C</Color>
    <Color x:Key="Color.Success">#1FA76B</Color>
    <Color x:Key="Color.Warning">#D9820B</Color>

    <Color x:Key="Color.TextPrimary">#1B2633</Color>
    <Color x:Key="Color.TextSecondary">#54677C</Color>
    <Color x:Key="Color.TextDim">#7C8FA6</Color>
    <Color x:Key="Color.BorderLine">#D5DFEA</Color>
    <Color x:Key="Color.BorderGlow">#B0C8DE</Color>

    <!-- ==================== 画刷 ==================== -->
    <SolidColorBrush x:Key="Brush.BgDeep" Color="{StaticResource Color.BgDeep}" />
    <SolidColorBrush x:Key="Brush.BgMid" Color="{StaticResource Color.BgMid}" />
    <SolidColorBrush x:Key="Brush.BgPanel" Color="{StaticResource Color.BgPanel}" />
    <SolidColorBrush x:Key="Brush.BgHover" Color="{StaticResource Color.BgHover}" />
    <SolidColorBrush x:Key="Brush.BgActive" Color="{StaticResource Color.BgActive}" />

    <SolidColorBrush x:Key="Brush.Neon" Color="{StaticResource Color.Neon}" />
    <SolidColorBrush x:Key="Brush.HoloBlue" Color="{StaticResource Color.HoloBlue}" />
    <SolidColorBrush x:Key="Brush.Violet" Color="{StaticResource Color.Violet}" />
    <SolidColorBrush x:Key="Brush.Magenta" Color="{StaticResource Color.Magenta}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}" />
    <SolidColorBrush x:Key="Brush.BorderLine" Color="{StaticResource Color.BorderLine}" />
    <SolidColorBrush x:Key="Brush.BorderGlow" Color="{StaticResource Color.BorderGlow}" />

    <!-- 窗口背景渐变 -->
    <LinearGradientBrush x:Key="Brush.WindowBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F3F6FB" />
        <GradientStop Offset="0.55" Color="#EEF3FA" />
        <GradientStop Offset="1" Color="#F2F5FA" />
    </LinearGradientBrush>

    <!-- 面板背景（半透明 + 细边框） -->
    <LinearGradientBrush x:Key="Brush.PanelBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#F2F6FB" />
    </LinearGradientBrush>

    <!-- 主按钮：青色渐变（日间加深） -->
    <LinearGradientBrush x:Key="Brush.Primary" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#00A7C6" />
        <GradientStop Offset="1" Color="#00C9E8" />
    </LinearGradientBrush>

    <!-- 次按钮：蓝紫渐变 -->
    <LinearGradientBrush x:Key="Brush.Accent" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#5E3DFF" />
        <GradientStop Offset="1" Color="#8B5CFF" />
    </LinearGradientBrush>

    <!-- 发光效果（日间减弱） -->
    <DropShadowEffect x:Key="Fx.GlowNeon" BlurRadius="10" ShadowDepth="0" Direction="0" Color="#00A7C6" Opacity="0.3" />
    <DropShadowEffect x:Key="Fx.GlowBlue" BlurRadius="8" ShadowDepth="0" Direction="0" Color="#2E6FC2" Opacity="0.25" />
    <DropShadowEffect x:Key="Fx.GlowDanger" BlurRadius="8" ShadowDepth="0" Direction="0" Color="#E0435C" Opacity="0.3" />
    <DropShadowEffect x:Key="Fx.ShadowCard" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#7C8FA6" Opacity="0.3" />

    <!-- 顶部标题栏发光细线画刷（日间） -->
    <LinearGradientBrush x:Key="Brush.TopLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#00FFFFFF" />
        <GradientStop Offset="0.15" Color="#6600A7C6" />
        <GradientStop Offset="0.5" Color="#CC0091B8" />
        <GradientStop Offset="0.85" Color="#666A4FD8" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>

</ResourceDictionary>
