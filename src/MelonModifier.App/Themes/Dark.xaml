<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 基础色板（HUD / Sci-Fi FUI） ==================== -->
    <Color x:Key="Color.BgDeep">#0A0F1A</Color>
    <Color x:Key="Color.BgMid">#0E1726</Color>
    <Color x:Key="Color.BgPanel">#121B2C</Color>
    <Color x:Key="Color.BgHover">#16223A</Color>
    <Color x:Key="Color.BgActive">#1A2A45</Color>

    <Color x:Key="Color.Neon">#00E5FF</Color>
    <Color x:Key="Color.HoloBlue">#4D9FFF</Color>
    <Color x:Key="Color.Violet">#7C4DFF</Color>
    <Color x:Key="Color.Magenta">#FF2E88</Color>
    <Color x:Key="Color.Danger">#FF5370</Color>
    <Color x:Key="Color.Success">#00E676</Color>
    <Color x:Key="Color.Warning">#FFB74D</Color>

    <Color x:Key="Color.TextPrimary">#E6EEF8</Color>
    <Color x:Key="Color.TextSecondary">#8FA3BF</Color>
    <Color x:Key="Color.TextDim">#5C6F8C</Color>
    <Color x:Key="Color.BorderLine">#1E2C44</Color>
    <Color x:Key="Color.BorderGlow">#2A3F63</Color>

    <!-- ==================== 画刷 ==================== -->
    <SolidColorBrush x:Key="Brush.BgDeep" Color="{StaticResource Color.BgDeep}" />
    <SolidColorBrush x:Key="Brush.BgMid" Color="{StaticResource Color.BgMid}" />
    <SolidColorBrush x:Key="Brush.BgPanel" Color="{StaticResource Color.BgPanel}" />
    <SolidColorBrush x:Key="Brush.BgHover" Color="{StaticResource Color.BgHover}" />
    <SolidColorBrush x:Key="Brush.BgActive" Color="{StaticResource Color.BgActive}" />

    <SolidColorBrush x:Key="Brush.Neon" Color="{StaticResource Color.Neon}" />
    <SolidColorBrush x:Key="Brush.HoloBlue" Color="{StaticResource Color.HoloBlue}" />
    <SolidColorBrush x:Key="Brush.Violet" Color="{StaticResource Color.Violet}" />
    <SolidColorBrush x:Key="Brush.Magenta" Color="{StaticResource Color.Magenta}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}" />
    <SolidColorBrush x:Key="Brush.BorderLine" Color="{StaticResource Color.BorderLine}" />
    <SolidColorBrush x:Key="Brush.BorderGlow" Color="{StaticResource Color.BorderGlow}" />

    <!-- 窗口背景渐变 -->
    <LinearGradientBrush x:Key="Brush.WindowBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0A0F1A" />
        <GradientStop Offset="0.55" Color="#0D1526" />
        <GradientStop Offset="1" Color="#0A1120" />
    </LinearGradientBrush>

    <!-- 面板背景（半透明 + 细边框） -->
    <LinearGradientBrush x:Key="Brush.PanelBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#14202F" />
        <GradientStop Offset="1" Color="#101A28" />
    </LinearGradientBrush>

    <!-- 主按钮：青色霓虹渐变 -->
    <LinearGradientBrush x:Key="Brush.Primary" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#00B8D9" />
        <GradientStop Offset="1" Color="#00E5FF" />
    </LinearGradientBrush>

    <!-- 次按钮：蓝紫渐变 -->
    <LinearGradientBrush x:Key="Brush.Accent" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#5E3DFF" />
        <GradientStop Offset="1" Color="#8B5CFF" />
    </LinearGradientBrush>

    <!-- 霓虹发光效果 -->
    <DropShadowEffect x:Key="Fx.GlowNeon" BlurRadius="14" ShadowDepth="0" Direction="0" Color="#00E5FF" Opacity="0.55" />
    <DropShadowEffect x:Key="Fx.GlowBlue" BlurRadius="12" ShadowDepth="0" Direction="0" Color="#4D9FFF" Opacity="0.4" />
    <DropShadowEffect x:Key="Fx.GlowDanger" BlurRadius="12" ShadowDepth="0" Direction="0" Color="#FF5370" Opacity="0.5" />
    <DropShadowEffect x:Key="Fx.ShadowCard" BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55" />
</ResourceDictionary>
